# WEEX API Credentials
WEEX_API_KEY=your_weex_api_key_here
WEEX_API_SECRET=your_weex_api_secret_here
WEEX_PASSPHRASE=your_weex_passphrase_here
WEEX_BASE_URL=https://api-contract.weex.com

# Telegram Notifications
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# Trading Mode
# Set DRY_RUN=True to test alerts without sending real orders
DRY_RUN=False

# Position & Risk Sizing
POSITION_SIZE_PCT=0.10
DEFAULT_LEVERAGE=3
MAX_CONCURRENT_TRADES=4
MAX_DAILY_LOSS_PCT=0.03
MAX_OPEN_CORR=0.85

# Strategy & Confluence Controls
MIN_CONFLUENCE_SCORE=3
MIN_RR=1.80

# Universe Selection
MIN_24H_VOLUME_USD=250000
MAX_PAIRS=200
